<UserControl x:Class="SplashIt.UI.Settings.Preview.PreviewStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             AutomationProperties.AutomationId="Settings.Preview">
    <!--
        The settings window's Preview (spec #1, Settings window): plain WPF TabItems — two
        projects (Tower selected, plus a second Tower view), one family and one .rte
        template — styled through PreviewStrip.Styler (the colorizer's TabStyleFactory) from the
        window's unsaved values. The strip has its own adorner layer, where the factory draws
        the selected tab's top line and the family bar. With "Color document tabs" off, every
        tab keeps the native style and a note says so.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SplashIt.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A flat, Revit-like document tab: the base every preview style is BasedOn. -->
            <Style x:Key="PreviewTabBase" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Margin="0,0,2,0" SnapsToDevicePixels="True">
                                <!-- Under the fill, the tab's own color: a project fill (#36) fades to half its opacity over it, as the
                                     preview's colors assume (PreviewStrip.Restyle), not to the window behind the strip. -->
                                <Border Background="{StaticResource HoverBrush}" BorderThickness="1,1,1,0" BorderBrush="Transparent" />
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,0" Padding="8,6,6,6">
                                    <!-- Like Revit's tabs, a narrow tab trims its title; the close glyph stays. The glyph
                                         is a named control, as Revit's mDocumentCloseButton, in a 16 px slot 12 px after the
                                         title, as Revit's, so the project fill's fade (#36) starts where it does on Revit's tabs and the factory gives
                                         it its own black or white over the fade under it. -->
                                    <DockPanel>
                                        <ContentControl x:Name="PART_CloseButton" DockPanel.Dock="Right" Margin="12,1,0,0" Width="16"
                                                        HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                        Focusable="False" IsTabStop="False"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" />
                                        </ContentControl>
                                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <ControlTemplate x:Key="StripTemplate" TargetType="TabControl">
                <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource SurfaceBrush}"
                        BorderThickness="0,0,0,3" Padding="6,8,6,0" SnapsToDevicePixels="True">
                    <!-- One row of equal tabs, as many as fit: the strip never wraps. -->
                    <UniformGrid Rows="1" IsItemsHost="True" />
                </Border>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
        <AdornerDecorator>
        <TabControl x:Name="Strip" Template="{StaticResource StripTemplate}" IsHitTestVisible="False" Focusable="False">
            <TabItem x:Name="Tower1Tab" AutomationProperties.AutomationId="Settings.Preview.Tower1" />
            <TabItem x:Name="Tower2Tab" AutomationProperties.AutomationId="Settings.Preview.Tower2" />
            <TabItem x:Name="AnnexTab" AutomationProperties.AutomationId="Settings.Preview.Annex" />
            <TabItem x:Name="FamilyTab" AutomationProperties.AutomationId="Settings.Preview.Family" />
            <TabItem x:Name="TemplateTab" AutomationProperties.AutomationId="Settings.Preview.Template" />
        </TabControl>
        </AdornerDecorator>
    </Border>
    <!-- With coloring off, every tab is native and this says why. -->
    <TextBlock x:Name="OffNote" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"
               AutomationProperties.AutomationId="Settings.Preview.OffNote" />
    </StackPanel>
</UserControl>
