<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SplashIt.UI — the WPF side of the add-in with NO Revit references (spec #1,
    Project split, decision #16): the tab style factory, the colorizer engine
    against ITabSurface and a document-info abstraction, the settings window
    and its view-models, the vendored theme and color picker. Theme detection
    reaches it as an input, not a Revit call.

    Multi-targeted so every Revit year can reference it: SplashIt.Revit picks
    net8.0-windows for R25/R26 and net10.0-windows for R27, and the net8.0-windows
    SplashIt.RuntimeTests can load it without Revit's runtime assemblies.
    Builds on Linux/macOS via EnableWindowsTargeting.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <RootNamespace>SplashIt.UI</RootNamespace>
    <AssemblyName>SplashIt.UI</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SplashIt.Core\SplashIt.Core.csproj" />
  </ItemGroup>

</Project>
