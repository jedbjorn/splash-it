<!--
    Copied from gantt-it src/GanttIt.Revit/UI/Swatches/ColorPickerDialog.xaml (gantt-it commit aa83f35, MIT, same owner).
    Changes: namespaces; strings from SplashIt.UI's UiStrings.resx (English, decision #8) instead of gantt-it's localization plumbing; the title is set per use (Project color 3, …).
-->
<Window x:Class="SplashIt.UI.Swatches.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:swatches="clr-namespace:SplashIt.UI.Swatches"
        xmlns:res="clr-namespace:SplashIt.UI.Resources"
        Title="{x:Static res:UiStrings.Color_DialogTitle}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="ToolWindow" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ColorPickerDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SplashIt.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="12">
        <swatches:ColorPicker />
        <Button Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" HorizontalAlignment="Right" Margin="0,4,0,0" MinWidth="80"
                AutomationProperties.AutomationId="ColorPicker.Cancel" />
    </StackPanel>
</Window>
